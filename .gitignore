# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Virtual environments
.venv/
venv/

# Secrets / local environment — never commit credentials (CLAUDE.md red line 8)
.env
.env.*

# uv cache (if redirected into the project)
.uv-cache/
